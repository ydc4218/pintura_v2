{
  "name": "pintura",
  "private": true,
  "version": "0.0.9",
  "type": "module",
  "scripts": {
    "dev": "npm version patch --no-git-tag-version && vite",
    "build": "npm version minor --no-git-tag-version && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "node --watch --watch-preserve-output --env-file=.env server/server.js",
    "all": "concurrently \"npm run dev\" \"npm run server\""
  },
  "dependencies": {
    "@heroui/react": "2.8.2",
    "axios": "1.11.0",
    "cors": "2.8.5",
    "express": "5.1.0",
    "framer-motion": "^12.23.12",
    "pg": "^8.16.3",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react-swc": "^3.10.2",
    "concurrently": "9.2.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "tailwindcss": "^4.1.11",
    "vite": "^7.0.4",
    "vite-plugin-pwa": "^1.0.2"
  }
}
